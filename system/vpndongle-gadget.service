[Unit]
Description=VPN-Dongle: USB-Netzwerkadapter (NCM-Gadget)
DefaultDependencies=no
After=systemd-modules-load.service sys-kernel-config.mount local-fs.target
Before=network-pre.target vpndongled.service
Wants=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/lib/vpndongle/usb-gadget.sh start
ExecStop=/usr/local/lib/vpndongle/usb-gadget.sh stop

[Install]
WantedBy=multi-user.target
