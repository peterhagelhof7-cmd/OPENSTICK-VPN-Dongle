                "trigger_prototypes": [
                  {
                    "description": "Häufig nur die Windows-Firewall (ICMP-Echo eingehend).",
                    "expression": "max(/OpenStick-VPN-Dongle/icmpping[{#PCIP},3],#3)=0",
                    "name": "PC {#PCIP} antwortet nicht auf Ping",
                    "priority": "INFO",
                    "uuid": "d9289936bc5b47cfb627873e8d8b410a"
                  }
                ],
                "type": "SIMPLE",
                "uuid": "de07182b14cd4fd28d5bd7cb423e7ef7",
                "valuemap": {
