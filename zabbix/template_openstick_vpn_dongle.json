    "templates": [
      {
        "description": "VPN-Dongle (UZ801/OpenStick) mit vpndongled: Uplink WLAN/LTE, VPN, WLAN-Gateway, PC, weitere Ziele.\nAutoregistrierung über HostMetadata \"openstick-vpn-dongle\"; die Überwachungsbereiche schaltet man in der Weboberfläche des Sticks.",
        "discovery_rules": [
          {
            "delay": "5m",
            "description": "Schalter „verbundenes WLAN“ in der Weboberfläche.",
            "item_prototypes": [
              {
                "delay": "0",
                "key": "vpndongle.wlan.up[{#IF}]",
                "master_item": {
                  "key": "vpndongle.status"
                },
                "name": "WLAN: verbunden",
                "preprocessing": [
                  {
                    "parameters": [
                      "$.wlan_up"
                    ],
                    "type": "JSONPATH"
                  },
                  {
                    "type": "BOOL_TO_DECIMAL"
                  }
                ],
                "tags": [
                  {
                    "tag": "component",
                    "value": "wlan"
                  }
                ],
                "trigger_prototypes": [
                  {
                    "expression": "max(/OpenStick-VPN-Dongle/vpndongle.wlan.up[{#IF}],{$VPNDONGLE.WLAN.DOWN})=0",
                    "name": "WLAN getrennt seit {$VPNDONGLE.WLAN.DOWN}",
                    "priority": "WARNING",
                    "uuid": "90a1a160008a424c985433d22f7f553d"
                  }
                ],
                "type": "DEPENDENT",
                "uuid": "a3821623aee14f93918e3a1ebc9943bc",
                "valuemap": {
                  "name": "VPN-Dongle Ja/Nein"
                }
              },
              {
                "delay": "0",
                "key": "vpndongle.wlan.signal[{#IF}]",
                "master_item": {
                  "key": "vpndongle.status"
                },
                "name": "WLAN: Signal",
                "preprocessing": [
                  {
                    "parameters": [
                      "$.wlan_signal"
                    ],
                    "type": "JSONPATH"
                  }
                ],
                "tags": [
                  {
                    "tag": "component",
                    "value": "wlan"
                  }
                ],
                "trigger_prototypes": [
                  {
                    "expression": "avg(/OpenStick-VPN-Dongle/vpndongle.wlan.signal[{#IF}],15m)<{$VPNDONGLE.WLAN.SIGNAL.MIN} and last(/OpenStick-VPN-Dongle/vpndongle.wlan.up[{#IF}])=1",
                    "name": "WLAN: schwaches Signal (<{$VPNDONGLE.WLAN.SIGNAL.MIN}%)",
                    "priority": "WARNING",
                    "uuid": "c3e8d5b059334eb7866c46a4bf447631"
                  }
                ],
                "type": "DEPENDENT",
                "units": "%",
                "uuid": "fb98ee89c922466d9f4f015d7149154c"
              },
              {
                "delay": "0",
                "key": "vpndongle.wlan.ssid[{#IF}]",
                "master_item": {
                  "key": "vpndongle.status"
                },
                "name": "WLAN: SSID",
                "preprocessing": [
                  {
                    "parameters": [
                      "$.wlan_ssid"
                    ],
                    "type": "JSONPATH"
                  },
                  {
                    "parameters": [
                      "1h"
                    ],
                    "type": "DISCARD_UNCHANGED_HEARTBEAT"
                  }
                ],
                "tags": [
                  {
                    "tag": "component",
                    "value": "wlan"
                  }
                ],
                "type": "DEPENDENT",
                "uuid": "212a3859633449528b4864417e4f79f7",
                "value_type": "CHAR"
              }
            ],
            "key": "vpndongle.discovery[wlan]",
            "lifetime": "1d",
            "name": "WLAN am Uplink",
            "type": "ZABBIX_ACTIVE",
            "uuid": "04bb366187df445d9c15530cea138950"
          },
          {
            "delay": "5m",
            "description": "Ping auf das Gateway des verbundenen WLANs (Simple Check auf dem Proxy des Sticks).",
            "item_prototypes": [
              {
                "key": "icmpping[{#WLANGW},3]",
                "name": "WLAN-Gateway {#WLANGW}: erreichbar",
                "tags": [
                  {
                    "tag": "component",
                    "value": "wlan"
                  }
                ],
                "trigger_prototypes": [
                  {
                    "expression": "max(/OpenStick-VPN-Dongle/icmpping[{#WLANGW},3],#3)=0",
                    "name": "WLAN-Gateway {#WLANGW} nicht erreichbar",
                    "priority": "AVERAGE",
                    "uuid": "2e14ec9a58d74991bca76f6e0785f120"
                  }
                ],
                "type": "SIMPLE",
                "uuid": "1e8fcefb62ff4d1eaeb3876f052dfda1",
                "valuemap": {
                  "name": "Service state"
                }
              },
              {
                "key": "icmppingloss[{#WLANGW},3]",
                "name": "WLAN-Gateway {#WLANGW}: Paketverlust",
                "tags": [
                  {
                    "tag": "component",
                    "value": "wlan"
                  }
                ],
                "trigger_prototypes": [
                  {
                    "expression": "min(/OpenStick-VPN-Dongle/icmppingloss[{#WLANGW},3],5m)>{$VPNDONGLE.LOSS.WARN} and min(/OpenStick-VPN-Dongle/icmppingloss[{#WLANGW},3],5m)<100",
                    "name": "WLAN-Gateway {#WLANGW}: hoher Paketverlust",
                    "priority": "WARNING",
                    "uuid": "f1e2f580fb7143acbf55e5daec26fee0"
                  }
                ],
                "type": "SIMPLE",
                "units": "%",
                "uuid": "1e1499c13fb641c086e1742152fa6bfd",
                "value_type": "FLOAT"
              },
              {
                "key": "icmppingsec[{#WLANGW},3,,,,avg]",
                "name": "WLAN-Gateway {#WLANGW}: Antwortzeit",
                "tags": [
                  {
                    "tag": "component",
                    "value": "wlan"
                  }
                ],
                "trigger_prototypes": [
                  {
                    "expression": "avg(/OpenStick-VPN-Dongle/icmppingsec[{#WLANGW},3,,,,avg],5m)>{$VPNDONGLE.RTT.WARN}",
                    "name": "WLAN-Gateway {#WLANGW}: hohe Antwortzeit",
                    "priority": "WARNING",
                    "uuid": "70c26ba6e197457eba00007485c7cfbb"
                  }
                ],
                "type": "SIMPLE",
                "units": "s",
                "uuid": "e52ba3f8786a4b378410b35310add371",
                "value_type": "FLOAT"
              }
            ],
            "key": "vpndongle.discovery[wlangw]",
            "lifetime": "1d",
            "name": "WLAN-Gateway",
            "type": "ZABBIX_ACTIVE",
            "uuid": "7ca6b35221aa4c5c9b0b02439cce0a16"
          },
          {
            "delay": "5m",
            "description": "Ping auf den PC am USB-Anschluss. Windows beantwortet Ping nur, wenn die Firewall ICMP erlaubt.",
            "item_prototypes": [
