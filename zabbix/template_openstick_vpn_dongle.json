                    "name": "PC {#PCIP}: hoher Paketverlust",
                    "priority": "WARNING",
                    "uuid": "33aabd1a464748238f8384df5790c787"
                  }
                ],
                "type": "SIMPLE",
                "units": "%",
                "uuid": "917a2ebdf7e0415b9c641d6580a1c90b",
                "value_type": "FLOAT"
              },
              {
                "key": "icmppingsec[{#PCIP},3,,,,avg]",
